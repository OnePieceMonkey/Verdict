# Nebius Token Factory (OpenAI-compatible). Model prices are pinned in packages/core/src/llm/pricing.ts
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_EXTRACT=nvidia/nemotron-3-super-120b-a12b
MODEL_REPAIR=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_EXPLAIN=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B

# Tavily
TAVILY_API_KEY=

# Verifier service (internal only)
