{
  "name": "@verdict/eval",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "testsuite:fetch": "tsx scripts/fetch-testsuite.ts",
    "verifier:check": "tsx --env-file-if-exists=../.env scripts/verifier-check.ts",
    "roundtrip:check": "tsx --env-file-if-exists=../.env scripts/roundtrip-check.ts",
    "corpus:build": "tsx --env-file-if-exists=../.env scripts/corpus-build.ts",
    "eval": "tsx --env-file-if-exists=../.env scripts/run-eval.ts"
  },
  "dependencies": {
    "@verdict/core": "workspace:*",
    "decimal.js": "^10.6.0",
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6",
    "pdfjs-dist": "^6.3.289"
  }
}
